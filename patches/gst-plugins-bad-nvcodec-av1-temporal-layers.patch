@@ -990,6 +1012,27 @@ gst_nv_av1_encoder_set_format (GstNvEncoder * encoder,
     }
   }
 
+  if (self->temporal_layers > 1) {
+    if (!gst_nvenc_is_api_13 ()) {
+      GST_WARNING_OBJECT (self, "temporal-layers=%u needs NVENC API 13.0 "
+          "(driver 570 or newer), encoding a single layer",
+          self->temporal_layers);
+    } else if (!svc_supported || svc_max_layers < 2) {
+      GST_WARNING_OBJECT (self, "temporal-layers=%u: the device has no AV1 "
+          "temporal SVC, encoding a single layer", self->temporal_layers);
+    } else if (self->gop_size == 0) {
+      GST_WARNING_OBJECT (self, "temporal-layers=%u: gop-size=0 encodes "
+          "intra frames only, encoding a single layer", self->temporal_layers);
+    } else {
+      temporal_layers = MIN (self->temporal_layers, (guint) svc_max_layers);
+      if (temporal_layers < self->temporal_layers) {
+        GST_WARNING_OBJECT (self, "temporal-layers=%u: the device supports "
+            "%u, encoding %u", self->temporal_layers, temporal_layers,
+            temporal_layers);
+      }
+    }
+  }
+
   init_params->version = gst_nvenc_get_initialize_params_version ();
   init_params->encodeGUID = NV_ENC_CODEC_AV1_GUID;
 
@@ -1060,6 +1103,10 @@ gst_nv_av1_encoder_set_format (GstNvEncoder * encoder,
     config->frameIntervalP = 0;
   }
 
+  /* temporal SVC takes no B-frames */
+  if (temporal_layers > 1)
+    config->frameIntervalP = 1;
+
   rc_params = &config->rcParams;
 
